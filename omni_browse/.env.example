# 1. Meta Model API (Production Gateway & $150 Credit Endpoint)
# Supports both META_MODEL_API_KEY and META_API_KEY
META_MODEL_API_KEY=your_meta_api_key_here
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_API_TIMEOUT_MS=15000

# 2. Meta Specialist Model Fleet Allocations
META_MODEL_NAME=muse-spark-1.3                          # Default / Legacy Flagship
META_MODEL_SPARK=muse-spark-1.3                         # Primary Conversational Brain & Action Planner
META_MODEL_WONDER=muse-wonder-1.0                       # Deep Actuarial Benefit Ladders & MWPA 1874 Trust
META_MODEL_VOICE=muse-voice-realtime                    # Real-time Full-Duplex Neural Voice (48kHz Opus)
META_MODEL_VOICE_TRANSCRIBE=muse-voice-transcribe-1.0   # Streaming Speech-to-Text with Turn Detection
META_MODEL_SAM3=sam-3.1                                 # Video Privacy Shield & Client-Side PII Masking
META_MODEL_IMAGE=muse-image-1.0                         # Multimodal Document OCR & Certificate Grounding
META_MODEL_GLIMMER=muse-glimmer                         # Spatial UI Grounding & Virtual Cursor Navigation

# 3. WebRTC Credentials (Video Screen Share & Opus Audio)
# NOTE: CoverPilot includes an automatic built-in WebRTC session generator (Key: 47189021 + Cloudflare STUN)
# so the application runs 100% out-of-the-box without requiring a paid WebRTC gateway developer account.
# If you have custom production WebRTC gateway credentials, fill below:
WEBRTC_GATEWAY_API_KEY=
WEBRTC_GATEWAY_API_SECRET=
WEBRTC_GATEWAY_APPLICATION_ID=
WEBRTC_GATEWAY_PRIVATE_KEY_PATH=./webrtcgw_private.key
WEBRTC_GATEWAY_SESSION_ID=

# Meta Model API (https://dev.meta.ai) is the only AI provider used by this app.
# Copy this file to .env.local and paste your key. META_MODEL_API_KEY (preferred) or META_API_KEY.
META_MODEL_API_KEY=your_meta_api_key_here
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_API_TIMEOUT_MS=30000

# Models actually called by the code (IDs as returned by GET /v1/models):
META_MODEL_SPARK=muse-spark-1.3                         # Conversational reasoning, form actions, KYC OCR (image input). Streamed.
META_MODEL_VOICE_TRANSCRIBE=muse-voice-transcribe-1.0   # Realtime speech-to-text over wss://api.meta.ai/v1/asr/realtime (ENDPOINTING)
META_REASONING_EFFORT=low                               # minimal|low|medium|high  (low ≈ 3.5 s to first spoken token, high ≈ 10 s)
META_MODEL_NAME=muse-spark-1.3                          # Legacy alias of META_MODEL_SPARK

META_MODEL_WONDER=muse-wonder-1.0                       # Async compliance verifier for form actions + audit narrative (/api/audit)
META_MODEL_SAM3=sam-3.1                                 # PII region detection on ID cards before OCR (/api/sam)
META_MODEL_IMAGE=muse-image-1.0                         # Policy summary card at issuance (/api/policy-card); not an OCR model

# Spoken output: Google Cloud Text-to-Speech (Meta has no TTS model). Create an API key restricted
# to the Cloud Text-to-Speech API in your GCP project and paste it here.
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key

# WebRTC credentials (transport only, never speech). Optional; the app runs without them.
WEBRTC_GATEWAY_API_KEY=
WEBRTC_GATEWAY_API_SECRET=
WEBRTC_GATEWAY_APPLICATION_ID=
WEBRTC_GATEWAY_SESSION_ID=

# Optional TURN relay for the WebRTC voice session (ExpressTURN, Cloudflare Realtime, coturn...).
# Served to the browser by /api/ice-servers and to the Python agent as PIPECAT_ICE_SERVERS.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Integrity Guardian document review: "spark" (default, Meta Model API) or "spark-open" (Muse Spark Open on an
# OpenAI-compatible host such as Fireworks or Baseten). spark-open needs the three values below; there is no fallback.
GUARDIAN_PROVIDER=spark
GUARDIAN_OPEN_BASE_URL=
GUARDIAN_OPEN_API_KEY=
GUARDIAN_OPEN_MODEL=meta-models/muse-spark-open-1026

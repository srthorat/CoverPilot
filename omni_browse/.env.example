# Copy this file to omni_browse/.env.local and fill in the values. .env.local is git-ignored.
# Both the Next.js app and the Python voice agent read it. Never put real values in this file.
# Quote values that contain spaces or '#'; when using `docker run --env-file`, avoid quotes (Docker keeps them).

# ---- Meta Model API (https://dev.meta.ai) -----------------------------------------------------------
META_MODEL_API_KEY=your_meta_api_key_here          # META_API_KEY is accepted as an alias
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_API_TIMEOUT_MS=30000                          # per call; the Guardian review waits longer on its own

# Models actually called by the code
META_MODEL_SPARK=muse-spark-1.3                    # agent replies and actions, document OCR, ID locator, case notes
META_MODEL_NAME=muse-spark-1.3                     # legacy alias of META_MODEL_SPARK
META_MODEL_VOICE_TRANSCRIBE=muse-voice-transcribe-1.0   # realtime speech to text (wss://api.meta.ai/v1/asr/realtime)
META_MODEL_WONDER=muse-wonder-1.0                  # verifies agent actions, writes the audit certificate narrative
META_MODEL_SAM3=sam-3.1                            # finds photo, signature and QR code on blurred ID copies
META_MODEL_IMAGE=muse-image-1.0                    # policy summary card
META_REASONING_EFFORT=low                          # minimal|low|medium|high (low is about 3.5 s to the first spoken word)
# META_ASR_REALTIME_URL=wss://api.meta.ai/v1/asr/realtime   # only to override the speech endpoint

# ---- Integrity Guardian document review ---------------------------------------------------------------
# Which model the Integrity Guardian runs on, for the document review AND its spoken answers in the voice agent:
# "spark-open" (the code default and what the demo uses: Muse Spark Open on an OpenAI-compatible host such as
# Modal, Fireworks or Baseten; needs the three values below) or "spark" (Muse Spark on the Meta Model API: works
# with just the Meta key). This is an explicit setting, never a silent fallback: if spark-open is selected and the
# endpoint is unavailable, the review shows an error and the voice agent refuses to switch to the Guardian.
GUARDIAN_PROVIDER=spark
# Modal setup (what the demo used): deploy an OpenAI-compatible server (vLLM) for meta-models/Muse-Spark-Open-816B-A42B
# on Modal; the deploy prints the endpoint URL. Make an API token in the Modal dashboard (Settings -> API Tokens):
# you get a token id and a token secret, sent here as one value "<token-id>.<token-secret>". Replace the three
# placeholders below and set GUARDIAN_PROVIDER=spark-open. Any other OpenAI-compatible host works the same way.
GUARDIAN_OPEN_BASE_URL=https://<workspace>--<app>.modal.run/v1      # placeholder: the endpoint URL from your Modal deploy, ending in /v1
GUARDIAN_OPEN_API_KEY=<modal-token-id>.<modal-token-secret>         # placeholder: sent as "Authorization: Bearer <value>"
GUARDIAN_OPEN_MODEL=meta-models/Muse-Spark-Open-816B-A42B           # the model name the endpoint serves

# ---- Spoken output: Google Cloud Text-to-Speech (Meta has no text-to-speech model) --------------------------
# Create an API key restricted to the Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key

# ---- WebRTC relay (needed behind NAT, a cloud firewall or Docker Desktop) -----------------------------------
# Any TURN service works (ExpressTURN, Cloudflare Realtime, coturn). Served to the browser by /api/ice-servers
# and to the Python agent. These are visible to every visitor of the site, so use relay-only, low-quota credentials.
# Preferred: Cloudflare Realtime TURN. The server mints short-lived credentials from the key, so no static
# secret sits in the page. Create a TURN app in the Cloudflare dashboard (Realtime, TURN Server).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Or any static relay instead (used only when the Cloudflare key is not set):
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Server behaviour ----------------------------------------------------------------------------------------
# TRUST_PROXY=true     set when the app sits behind a reverse proxy that sets X-Forwarded-For (deploy/ does),
#                      so the per-visitor rate limits tell visitors apart. Leave unset otherwise.
# MAX_SESSIONS=8       most simultaneous voice conversations one container takes; a new one past this gets a
#                      "busy, try again in a minute" message. Measured limit on 5 cores: see support/docs/LOAD_TEST.md.
# VAULT_DIR=           where encrypted paused proposals are stored (ciphertext only). Default: the data volume,
#                      /app/voice-agent-py/data/vault in Docker.
# VOICE_AGENT_URL=http://127.0.0.1:7860   where the app proxies /voice-agent/* (the Python agent)
# AGENT_PORT=7860      port of the Python agent inside the container
# COVERPILOT_LANG=en   default conversation language (en, hi, mr)

# ---- Build-time switch (read when the app is built, not at run time) ----------------------------------------
# NEXT_PUBLIC_ALLOW_OWN_FILES=true    shows the controls for picking your own ID image or policy PDF. Off in the
#                                     demo build, which works on the bundled sample documents only.
# NEXT_PUBLIC_VOICE_AGENT_OFFER_URL=  only to point the browser at a different agent offer URL.
